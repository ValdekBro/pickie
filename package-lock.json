{
  "name": "pickie",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "pickie",
      "version": "0.1.0",
      "hasInstallScript": true,
      "workspaces": [
        "apps/*"
      ],
      "engines": {
        "node": ">=20 <21",
        "npm": ">=10"
      }
    },
    "apps/api": {
      "name": "@pickie/api",
      "version": "0.1.0",
      "engines": {
        "node": ">=20 <21",
        "npm": ">=10"
      }
    },
    "apps/web": {
      "name": "@pickie/web",
      "version": "0.1.0",
      "engines": {
        "node": ">=20 <21",
        "npm": ">=10"
      }
    },
    "node_modules/@pickie/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@pickie/web": {
      "resolved": "apps/web",
      "link": true
    }
  }
}

# Enforce LF line endings for text files in repo
* text=auto eol=lf

# Common text files
*.md   text
*.ts   text
*.tsx  text
*.js   text
*.jsx  text
*.json text
*.jsonc text
*.yml  text
*.yaml text
*.xml  text
*.svg  text
*.env  text

# Shell scripts
*.sh   text eol=lf
*.bash text eol=lf

# Windows scripts (keep CRLF for native Windows tooling)
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets (no diffs)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary

# Fonts / media (binary)
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.mp4   binary
*.webm  binary
*.mp3   binary
*.ogg   binary
*.wav   binary

# Archives (binary)
*.zip  binary
*.tar  binary
*.gz   binary
*.bz2  binary


{
  "name": "@pickie/frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Pickie Frontend (React)",
  "type": "commonjs",
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "echo \"web dev not configured yet\"",
    "build": "echo \"web build not configured yet\"",
    "start": "echo \"web start not configured yet\"",
    "typecheck": "echo \"web typecheck not configured yet\"",
    "lint": "eslint \"src/**/*.{ts,tsx,jsx,js}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,jsx,js}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,jsx,js,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,jsx,js,md,json,yml,yaml}\""
  },
  "browserslist": [
    "last 2 Safari versions"
  ]
}



# Environment: API (NestJS)

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Databases
# PostgreSQL main application DB (use compose service hostname when running via docker-compose)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/pickie?schema=public

# MongoDB staging for datasource ingestion (use compose service hostname when running via docker-compose)
MONGODB_URI=mongodb://mongo:27017/pickie_staging


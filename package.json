{
  "name": "pickie",
  "private": true,
  "version": "0.1.0",
  "description": "Pickie monorepo (api + web)",
  "type": "commonjs",
  "license": "MIT",
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10"
  },
  "packageManager": "npm@10",
  "workspaces": [
    "api",
    "web",
    "datasource"
  ],
  "overrides": {
    "@types/node": "20.x"
  },
  "scripts": {
    "preinstall": "node -e \"const [major]=process.versions.node.split('.') .map(Number); if(major!==20){console.error('Node 20.x required; detected '+process.version); process.exit(1);}\"",
    "prebuild": "npm run -ws --if-present format && npm run -ws --if-present lint",
    "dev": "npm run -ws --if-present dev --parallel",
    "build": "npm run -ws --if-present build",
    "typecheck": "npm run -ws --if-present typecheck",
    "lint": "npm run -ws --if-present lint",
    "lint:fix": "npm run -ws --if-present lint:fix",
    "format": "npm run -ws --if-present format",
    "format:check": "npm run -ws --if-present format:check",
    "test": "npm run -ws --if-present test",
    "test:watch": "npm run -ws --if-present test:watch"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "@types/jest": "^30.0.0",
    "jest": "^30.1.3",
    "mongodb-memory-server": "^10.1.4",
    "ts-jest": "^29.4.1"
  }
}

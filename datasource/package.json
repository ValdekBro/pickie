{
  "name": "@pickie/scrappers",
  "private": true,
  "version": "0.1.0",
  "description": "Pickie Scrappers (collect raw data → MongoDB staging)",
  "type": "commonjs",
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "echo \"scrappers dev not configured yet\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,md,json,yml,yaml}\"",
    "test": "jest -c jest.config.ts",
    "test:watch": "jest -c jest.config.ts --watch"
  },
  "dependencies": {
    "mongodb": "^6.7.0",
    "playwright": "^1.46.0",
    "zod": "^3.23.8"
  }
}


